# ============================================
# SCALAFLOW — Variáveis de Ambiente (exemplo)
# Copie este arquivo para .env e preencha os valores reais.
# NÃO committe o arquivo .env com valores reais.
# ============================================

# Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SEU_VALOR_AQUI
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SEU_VALOR_AQUI
SUPABASE_SERVICE_ROLE_KEY=sb_secret_SEU_VALOR_AQUI

# Apify
APIFY_TOKEN=apify_api_SEU_TOKEN_AQUI
APIFY_BASE_URL=https://api.apify.com/v2

# Apify Actors (IDs padrão)
APIFY_META_ADS_ACTOR=curious_coder/facebook-ads-library-scraper
APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper
APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper
APIFY_GOOGLE_TRENDS_ACTOR=apify~google-trends-scraper
APIFY_YOUTUBE_ACTOR=streamers~youtube-scraper
APIFY_ECOMMERCE_ACTOR=junglee/free-amazon-product-scraper
APIFY_ECOMMERCE_AMAZON_ACTOR=junglee/free-amazon-product-scraper

# APIs de IA
ANTHROPIC_API_KEY=sk-ant-api03-SUA_CHAVE_AQUI
OPENAI_API_KEY=sk-proj-SUA_CHAVE_AQUI
GEMINI_API_KEY=AIzaSySUA_CHAVE_AQUI

# Cris OS — handoff de inteligência de mercado (Fase 9)
# Integração opt-in: se ausente, o handoff fica NOT_SENT e nada quebra.
# CRIS_OS_API_URL deve ser a URL completa do endpoint receptor (não uma base).
CRIS_OS_API_URL=
CRIS_OS_INTEGRATION_TOKEN=

# Athena Control — integração somente-leitura (agregados reais)
# Chave EXCLUSIVA do ScalaFlow para a Athena. Gerar com: openssl rand -hex 32
# Configurar na Vercel (Production) como SCALAFLOW_ATHENA_API_KEY.
SCALAFLOW_ATHENA_API_KEY=

# Fase 1 (central) — variáveis que faltavam documentar (sem valores reais).
# CRIS_OS_MINING_SECRET / CRIS_OS_MINING_USER_ID: auth da rota
# POST /api/integrations/mining/run (o mining atribui tudo a este user).
CRIS_OS_MINING_SECRET=
CRIS_OS_MINING_USER_ID=
# CRIS_OS_STATUS_URL (opcional, sem omissão): base do endpoint de estado
# publicado pelo Cris OS para polling autenticado, ex.:
# https://cris-os.example.com/api/intelligence/handoff-status
# Sem esta variável, a consulta de estado devolve só o registo local.
CRIS_OS_STATUS_URL=
# SCALAFLOW_ORGANIZATION_ID (opcional): âmbito org registado nos missions.
# Ausente = single-tenant hoje; multi-org é fase futura, não simulada.
SCALAFLOW_ORGANIZATION_ID=
