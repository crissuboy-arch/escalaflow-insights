# ============================================
# SCALAFLOW — Variáveis de Ambiente (exemplo)
# Copie este arquivo para .env e preencha os valores reais.
# NÃO committe o arquivo .env com valores reais.
# ============================================

# Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SEU_VALOR_AQUI
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SEU_VALOR_AQUI
SUPABASE_SERVICE_ROLE_KEY=sb_secret_SEU_VALOR_AQUI

# Apify
APIFY_TOKEN=apify_api_SEU_TOKEN_AQUI
APIFY_BASE_URL=https://api.apify.com/v2

# Apify Actors (IDs padrão)
APIFY_META_ADS_ACTOR=curious_coder/facebook-ads-library-scraper
APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper
APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper
APIFY_GOOGLE_TRENDS_ACTOR=apify~google-trends-scraper
APIFY_YOUTUBE_ACTOR=streamers~youtube-scraper
APIFY_ECOMMERCE_ACTOR=junglee/free-amazon-product-scraper
APIFY_ECOMMERCE_AMAZON_ACTOR=junglee/free-amazon-product-scraper

# APIs de IA
ANTHROPIC_API_KEY=sk-ant-api03-SUA_CHAVE_AQUI
OPENAI_API_KEY=sk-proj-SUA_CHAVE_AQUI
GEMINI_API_KEY=AIzaSySUA_CHAVE_AQUI

# Cris OS — handoff de inteligência de mercado (Fase 9)
# Integração opt-in: sem as duas variáveis, nenhum handoff é enviado.
# Use a URL completa do receptor documentado no Cris OS, por exemplo:
# https://SEU-HOST/integrations/scalaflow/intelligence
# O ScalaFlow usa a mesma URL para POST e acrescenta /{handoff_id}/status no GET.
# Guarde o token apenas nos Secrets da Vercel/ambiente servidor; nunca no VITE_.
CRIS_OS_API_URL=
CRIS_OS_INTEGRATION_TOKEN=

# Athena Control — integração somente-leitura (agregados reais)
# Chave EXCLUSIVA do ScalaFlow para a Athena. Gerar com: openssl rand -hex 32
# Configurar na Vercel (Production) como SCALAFLOW_ATHENA_API_KEY.
SCALAFLOW_ATHENA_API_KEY=

# Fase 1 (central) — variáveis que faltavam documentar (sem valores reais).
# CRIS_OS_MINING_SECRET / CRIS_OS_MINING_USER_ID: auth da rota
# POST /api/integrations/mining/run (o mining atribui tudo a este user).
CRIS_OS_MINING_SECRET=
CRIS_OS_MINING_USER_ID=
# CRIS_OS_STATUS_URL (opcional): base da coleção de estado do Cris OS
# (ex.: https://cris-os.example.com/api/integrations/scalaflow/intelligence).
# A consulta faz GET {base}/{handoff_id}/status. Sem esta variável, a base
# é derivada da origem de CRIS_OS_API_URL + o path real auditado; sem
# nenhuma das duas, a consulta devolve só o registo local.
CRIS_OS_STATUS_URL=
# SCALAFLOW_ORGANIZATION_ID (opcional): âmbito org registado nos missions.
# Ausente = single-tenant hoje; multi-org é fase futura, não simulada.
SCALAFLOW_ORGANIZATION_ID=

# --- Integrações de ferramentas (Fase 3/5; todas OPCIONAIS e VAZIAS) ---
# Nenhuma destas variáveis é necessária para o ScalaFlow correr. Cada
# uma só é lida pelo seu adaptador (src/lib/missions/adapters/); sem ela,
# o adaptador devolve configured:false e o painel mostra o estado real.
# NUNCA colocar valores reais aqui — só no ambiente do servidor (Vercel).
# CRIS_OS_BRIDGE_TOKEN NÃO pertence aqui: é Cris OS↔Athena, não ScalaFlow.
# Tools Hub — catálogo/jobs (deploy + worker ainda por confirmar)
TOOLS_HUB_BASE_URL=
TOOLS_HUB_API_KEY=
# Pink Logic — geração de imagens/copy/design
PINK_LOGIC_BASE_URL=
PINK_LOGIC_SERVICE_KEY=
# PageForge — geração de páginas de venda
PAGEFORGE_BASE_URL=
PAGEFORGE_ATHENA_API_KEY=
# Meta Ads — só leituras HTTP (status/insights/live); OAuth é do serviço
META_ADS_BASE_URL=
