{
  "manifest_version": 3,
  "name": "EscalaFlow Miner",
  "version": "1.2.0",
  "description": "Minera anúncios da Meta Ads Library, salva no EscalaFlow e dispara análise automática no ChatGPT.",
  "permissions": ["activeTab", "storage", "tabs", "scripting", "downloads"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://*.facebook.com/*",
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://escalaflow-insights.vercel.app/*",
    "https://*.vercel.app/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png",
    "default_title": "EscalaFlow Miner"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://facebook.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": ["chatgpt.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "48": "icon.png", "128": "icon.png" }
}
